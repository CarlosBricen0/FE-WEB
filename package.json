{
  "name": "fe-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "prod": "npm run build && npm start",
    "format:prettier": "prettier --write '*/**/*.{js,jsx,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "check:env": "tsx scripts/check-env.ts",
    "sync:components": "npm install --no-install-links ../FE-React",
    "postinstall": "prisma generate",
    "lint": "eslint src",
    "test:http": "node scripts/smoke-http.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "db:local:stop": "node scripts/local-postgres.mjs --stop",
    "check:services": "tsx scripts/check-services.ts",
    "test:integration": "node scripts/test-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:backup:verify": "node scripts/backup-database.mjs --verify"
  },
  "dependencies": {
    "components-front-end": "file:../FE-React",
    "next": "16.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@kinde-oss/kinde-auth-nextjs": "2.13.2",
    "@prisma/client": "^5.15.1",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@react-email/components": "1.0.12",
    "@tanstack/react-query": "^5.45.1",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.395.0",
    "next-cloudinary": "7.0.0",
    "next-themes": "^0.3.0",
    "prisma": "^5.15.1",
    "resend": "6.35.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "tsx": "^4.20.0",
    "autoprefixer": "^10.4.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
