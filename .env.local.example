# App and local database (npm run db:local generates ignored local credentials)
NEXT_PUBLIC_BASE_URL=http://localhost:3001
DATABASE_URL=
TEST_DATABASE_URL=
ADMIN_EMAIL=
# Mandatory immutable Kinde identity for production administration
ADMIN_USER_ID=
# Kinde
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3001
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3001
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3001/auth/callback
# Mercado Pago Chile: test first. Never prefix secrets with NEXT_PUBLIC_.
MERCADOPAGO_MODE=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_COLLECTOR_ID=
# Optional buyer test-account email, used only in test mode
MERCADOPAGO_TEST_PAYER_EMAIL=
MERCADOPAGO_WEBHOOK_SECRET=
# Public HTTPS endpoint /api/webhooks/mercadopago (tunnel in local development)
MERCADOPAGO_WEBHOOK_URL=
# Whole CLP pesos. Define business prices explicitly; no conversion from tutorial USD.
MEMBERSHIP_MONTHLY_CLP=
MEMBERSHIP_YEARLY_CLP=
# Cloudinary signed avatar preset (jpg/png/webp, max 5 MB)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_AVATAR_PRESET=
# Resend
RESEND_API_KEY=
EMAIL_FROM=
# Authenticates both email and billing reconciliation cron endpoints
CRON_SECRET=
